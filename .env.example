# Storage Mode: 'local' for development, 'aws' for production
STORAGE_MODE=local

# ============================================================
# LOCAL MODE SETTINGS
# ============================================================
LOCAL_DATA_DIR=./data
LOCAL_RAW_DIR=./data/raw
LOCAL_PROCESSED_DIR=./data/processed
LOCAL_METADATA_DIR=./data/metadata

# ============================================================
# AWS SETTINGS (required when STORAGE_MODE=aws)
# ============================================================
AWS_REGION=us-east-1

# S3 Buckets
S3_BUCKET_RAW=your-raw-bucket
S3_BUCKET_PROCESSED=your-processed-bucket
S3_PREFIX_PROCESSED=processed
S3_PREFIX_METADATA=metadata

# Athena
ATHENA_DATABASE=table_cards
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# ============================================================
# LLM SETTINGS
# ============================================================
# Provider: 'bedrock' (default), 'anthropic', or 'mock'
LLM_PROVIDER=bedrock

# Bedrock (when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Anthropic direct (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# LLM parameters
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ============================================================
# PROFILING SETTINGS
# ============================================================
CARDINALITY_THRESHOLD=20
SAMPLE_VALUES_COUNT=10
SAMPLE_ROWS_FOR_LLM=20

# Table ID prefix
TABLE_ID_PREFIX=tbl
